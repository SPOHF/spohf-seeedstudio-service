# Copy to .env for local runs. On Railway, set these as service Variables.
DASHBOARD_URL=https://spohf-twin.example.com/dashboard
LOGIN_USERNAME=
LOGIN_PASSWORD=

# CSS selectors of the figures to screenshot -> served at /fig/1, /fig/2, ...
# (if no FIGn_SELECTOR is set, CHART_SELECTOR is used as the only figure)
# FIG1_SELECTOR=article.card:has(h2:has-text("Risk timeline"))
# FIG2_SELECTOR=article.card:has(h2:has-text("Climate —"))
CHART_SELECTOR=body

# Login form selectors (defaults cover most OAuth providers incl. Microsoft)
# USERNAME_SELECTOR=input[type="email"], input[name="username"], input[name="loginfmt"], #username
# PASSWORD_SELECTOR=input[type="password"]
# SUBMIT_SELECTOR=button[type="submit"], input[type="submit"]
# POST_LOGIN_CLICK_SELECTOR=#idSIButton9

INTERVAL_MINUTES=30
VIEWPORT_WIDTH=1600
VIEWPORT_HEIGHT=1200
SETTLE_MS=3000

# Downscale the PNG to this width (0 = keep original); cache header for /chart.png
IMAGE_MAX_WIDTH=0
CACHE_SECONDS=60
